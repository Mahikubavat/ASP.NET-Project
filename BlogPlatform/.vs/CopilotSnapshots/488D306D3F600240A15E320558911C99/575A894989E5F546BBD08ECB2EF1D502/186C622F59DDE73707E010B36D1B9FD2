using System;
using System.Collections.Generic;

public class Post
{
    public int Id { get; set; }
    public string Title { get; set; }
    public string Slug { get; set; }
    public string Content { get; set; }
    public string FeaturedImageUrl { get; set; }
    public DateTime PublishedAt { get; set; } = DateTime.UtcNow;
    public bool IsPublished { get; set; } = true;

    public int? CategoryId { get; set; }
    public Category Category { get; set; }

    public string AuthorId { get; set; }
    public ApplicationUser Author { get; set; }

    public virtual ICollection<PostTag> PostTags { get; set; } = new List<PostTag>();
    public virtual ICollection<Comment> Comments { get; set; } = new List<Comment>();
    public virtual ICollection<Like> Likes { get; set; } = new List<Like>();
}public class PostTag
{
    public int PostId { get; set; }
    public Post Post { get; set; }

    public int TagId { get; set; }
    public Tag Tag { get; set; }
}public class Tag
{
    public int Id { get; set; }
    public string Name { get; set; }
    public string Slug { get; set; }

    public virtual ICollection<PostTag> PostTags { get; set; } = new List<PostTag>();
}using Microsoft.AspNetCore.Identity;
using System.Collections.Generic;

public class ApplicationUser : IdentityUser
{
    public string Bio { get; set; }
    public string ProfilePictureUrl { get; set; }
    public string TwitterUrl { get; set; }
    public string LinkedInUrl { get; set; }
    public string GitHubUrl { get; set; }

    public virtual ICollection<Post> Posts { get; set; } = new List<Post>();
    public virtual ICollection<Comment> Comments { get; set; } = new List<Comment>();
    public virtual ICollection<Like> Likes { get; set; } = new List<Like>();
}using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using System;
using System.Linq;
using System.Threading.Tasks;

[Authorize]
public class PostsController : Controller
{
    private readonly ApplicationDbContext _db;
    private readonly IFileStorageService _fileStorage;
    private readonly IWebHostEnvironment _env;

    public PostsController(ApplicationDbContext db, IFileStorageService fileStorage, IWebHostEnvironment env)
    {
        _db = db; _fileStorage = fileStorage; _env = env;
    }

    [AllowAnonymous]
    public async Task<IActionResult> Index(int? categoryId, string tag, string q, int page = 1)
    {
        var query = _db.Posts
            .Include(p => p.Category)
            .Include(p => p.Author)
            .Include(p => p.PostTags).ThenInclude(pt => pt.Tag)
            .Where(p => p.IsPublished);

        if (categoryId.HasValue) query = query.Where(p => p.CategoryId == categoryId.Value);
        if (!string.IsNullOrWhiteSpace(tag)) query = query.Where(p => p.PostTags.Any(pt => pt.Tag.Name.Contains(tag)));
        if (!string.IsNullOrWhiteSpace(q)) query = query.Where(p => p.Title.Contains(q) || p.Content.Contains(q) || p.PostTags.Any(pt => pt.Tag.Name.Contains(q)));

        var posts = await query.OrderByDescending(p => p.PublishedAt).ToListAsync();
        return View(posts);
    }

    [AllowAnonymous]
    public async Task<IActionResult> Details(int id)
    {
        var post = await _db.Posts
            .Include(p => p.Author)
            .Include(p => p.Category)
            .Include(p => p.PostTags).ThenInclude(pt => pt.Tag)
            .Include(p => p.Comments).ThenInclude(c => c.User)
            .Include(p => p.Likes)
            .FirstOrDefaultAsync(p => p.Id == id);

        if (post == null) return NotFound();
        return View(post);
    }

    public async Task<IActionResult> Create()
    {
        ViewBag.Categories = await _db.Categories.ToListAsync();
        ViewBag.Tags = await _db.Tags.ToListAsync();
        return View();
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    public async Task<IActionResult> Create(PostCreateEditViewModel vm)
    {
        if (!ModelState.IsValid) { ViewBag.Categories = await _db.Categories.ToListAsync(); ViewBag.Tags = await _db.Tags.ToListAsync(); return View(vm); }

        var post = new Post
        {
            Title = vm.Title,
            Slug = vm.Slug ?? vm.Title?.ToLower().Replace(' ', '-'),
            Content = vm.Content,
            CategoryId = vm.CategoryId,
            AuthorId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value,
            IsPublished = vm.IsPublished
        };

        if (vm.FeaturedImage != null)
        {
            post.FeaturedImageUrl = await _fileStorage.SaveFileAsync(vm.FeaturedImage, "posts");
        }

        // handle tags: either SelectedTagIds or CommaSeparated
        if (vm.SelectedTagIds?.Any() == true)
        {
            foreach (var tid in vm.SelectedTagIds)
            {
                post.PostTags.Add(new PostTag { TagId = tid });
            }
        }
        else if (!string.IsNullOrWhiteSpace(vm.TagsCommaSeparated))
        {
            var names = vm.TagsCommaSeparated.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim()).Where(s => s.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase);
            foreach (var name in names)
            {
                var tag = await _db.Tags.FirstOrDefaultAsync(t => t.Name == name) ?? new Tag { Name = name, Slug = name.ToLower().Replace(' ', '-') };
                if (tag.Id == 0) _db.Tags.Add(tag);
                post.PostTags.Add(new PostTag { Tag = tag });
            }
        }

        _db.Posts.Add(post);
        await _db.SaveChangesAsync();
        return RedirectToAction(nameof(Details), new { id = post.Id });
    }

    public async Task<IActionResult> Edit(int id)
    {
        var post = await _db.Posts.Include(p => p.PostTags).FirstOrDefaultAsync(p => p.Id == id);
        if (post == null) return NotFound();
        if (post.AuthorId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value) return Forbid();

        var vm = new PostCreateEditViewModel
        {
            Id = post.Id,
            Title = post.Title,
            Slug = post.Slug,
            Content = post.Content,
            CategoryId = post.CategoryId,
            IsPublished = post.IsPublished,
            ExistingFeaturedImageUrl = post.FeaturedImageUrl,
            SelectedTagIds = post.PostTags.Select(pt => pt.TagId).ToList()
        };
        ViewBag.Categories = await _db.Categories.ToListAsync();
        ViewBag.Tags = await _db.Tags.ToListAsync();
        return View(vm);
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    public async Task<IActionResult> Edit(int id, PostCreateEditViewModel vm)
    {
        if (id != vm.Id) return BadRequest();
        if (!ModelState.IsValid) { ViewBag.Categories = await _db.Categories.ToListAsync(); ViewBag.Tags = await _db.Tags.ToListAsync(); return View(vm); }

        var post = await _db.Posts.Include(p => p.PostTags).FirstOrDefaultAsync(p => p.Id == id);
        if (post == null) return NotFound();
        if (post.AuthorId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value) return Forbid();

        post.Title = vm.Title;
        post.Slug = vm.Slug ?? vm.Title?.ToLower().Replace(' ', '-');
        post.Content = vm.Content;
        post.CategoryId = vm.CategoryId;
        post.IsPublished = vm.IsPublished;

        if (vm.FeaturedImage != null)
        {
            // delete old
            // optionally inject env: _fileStorage.DeleteFileIfExists(post.FeaturedImageUrl, _env);
            post.FeaturedImageUrl = await _fileStorage.SaveFileAsync(vm.FeaturedImage, "posts");
        }

        // update tags (simple approach: remove all and re-add)
        post.PostTags.Clear();
        if (vm.SelectedTagIds?.Any() == true)
        {
            foreach (var tid in vm.SelectedTagIds) post.PostTags.Add(new PostTag { TagId = tid, PostId = post.Id });
        }
        else if (!string.IsNullOrWhiteSpace(vm.TagsCommaSeparated))
        {
            var names = vm.TagsCommaSeparated.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim()).Where(s => s.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase);
            foreach (var name in names)
            {
                var tag = await _db.Tags.FirstOrDefaultAsync(t => t.Name == name) ?? new Tag { Name = name, Slug = name.ToLower().Replace(' ', '-') };
                if (tag.Id == 0) _db.Tags.Add(tag);
                post.PostTags.Add(new PostTag { Tag = tag });
            }
        }

        await _db.SaveChangesAsync();
        return RedirectToAction(nameof(Details), new { id = post.Id });
    }
}using BlogPlatform.Data;
using BlogPlatform.Models;
using Microsoft.AspNetCore.DataProtection;
using Microsoft.AspNetCore.Identity;
using Microsoft.EntityFrameworkCore;

var builder = WebApplication.CreateBuilder(args);

// Guard against a bare "HTTP ERROR 400" caused by an oversized Cookie header
// (e.g. leftover/stale cookies accumulated from earlier local testing).
builder.WebHost.ConfigureKestrel(options =>
{
    options.Limits.MaxRequestHeadersTotalSize = 64 * 1024; // default is 32KB
    options.Limits.MaxRequestHeaderCount = 200;
});

// 1. Register Database Context (uses a local SQLite file: app.db)
var connectionString = builder.Configuration.GetConnectionString("DefaultConnection")
    ?? throw new InvalidOperationException("Connection string 'DefaultConnection' not found.");

builder.Services.AddDbContext<ApplicationDbContext>(options =>
    options.UseSqlServer(connectionString));

builder.Services.AddDatabaseDeveloperPageExceptionFilter();

// Persist Data Protection keys to a stable folder next to the project so antiforgery/session
// cookies stay valid across app restarts (otherwise every restart invalidates in-flight forms,
// which surfaces to the user as an "HTTP ERROR 400" when they submit).
builder.Services.AddDataProtection()
    .PersistKeysToFileSystem(new DirectoryInfo(Path.Combine(builder.Environment.ContentRootPath, "Keys")))
    .SetApplicationName("BlogPlatform");

// 2. Register Identity with custom ApplicationUser and IdentityRole
builder.Services.AddIdentity<ApplicationUser, IdentityRole>(options => {
    options.SignIn.RequireConfirmedAccount = false;
})
.AddEntityFrameworkStores<ApplicationDbContext>()
.AddDefaultTokenProviders()
.AddDefaultUI();

builder.Services.AddControllersWithViews();
builder.Services.AddRazorPages();
// file storage for uploads
builder.Services.AddScoped<BlogPlatform.Services.IFileStorageService, BlogPlatform.Services.FileStorageService>();

var app = builder.Build();

// 3. Create the database (if missing) and seed roles/admin/categories on startup
using (var scope = app.Services.CreateScope())
{
    var services = scope.ServiceProvider;
    var db = services.GetRequiredService<ApplicationDbContext>();
    await db.Database.EnsureCreatedAsync();

    await DbInitializer.SeedRolesAndAdminAsync(services);
    await DbInitializer.SeedCategoriesAsync(db);
}

// Configure HTTP pipeline
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}

app.UseHttpsRedirection();
app.UseStaticFiles();

app.UseRouting();

app.UseAuthentication();
app.UseAuthorization();

app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Home}/{action=Index}/{id?}");
app.MapRazorPages();

app.Run();