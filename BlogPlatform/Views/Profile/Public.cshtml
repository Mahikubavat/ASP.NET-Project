@model BlogPlatform.Models.ApplicationUser
@{
    ViewData["Title"] = (Model?.UserName ?? "User") + " - Profile";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isOwnProfile = currentUserId == Model?.Id;
}

<div class="row g-4">
    <!-- User Profile Header Card -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div style="height: 120px; background: linear-gradient(135deg, #4f46e5 0%, #38bdf8 100%);"></div>
            <div class="card-body p-4 pt-0">
                <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end justify-content-between gap-3" style="margin-top: -60px;">
                    <div class="d-flex flex-column flex-md-row align-items-center gap-3 text-center text-md-start">
                        @if (!string.IsNullOrEmpty(Model?.ProfilePictureUrl ?? Model?.AvatarUrl))
                        {
                            <img src="@(Model?.ProfilePictureUrl ?? Model?.AvatarUrl)" class="rounded-circle shadow border border-4 border-white" style="width: 120px; height: 120px; object-fit: cover;" alt="@(Model?.UserName ?? "User")" />
                        }
                        else
                        {
                            <div class="rounded-circle shadow border border-4 border-white bg-white text-primary d-flex align-items-center justify-content-center" style="width: 120px; height: 120px; font-size: 3rem;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                        <div>
                            <h2 class="h3 fw-bold mb-1">@Model?.UserName</h2>
                            <p class="text-muted mb-2">@(string.IsNullOrWhiteSpace(Model?.Bio) ? "Passionate writer and reader on BlogPlatform." : Model.Bio)</p>
                            
                            <!-- Social links -->
                            <div class="d-flex gap-2 justify-content-center justify-content-md-start">
                                @if (!string.IsNullOrEmpty(Model?.TwitterUrl))
                                {
                                    <a href="@Model.TwitterUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary rounded-pill">
                                        <i class="bi bi-twitter-x me-1"></i> Twitter
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model?.LinkedInUrl))
                                {
                                    <a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="bi bi-linkedin me-1"></i> LinkedIn
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model?.GitHubUrl))
                                {
                                    <a href="@Model.GitHubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark rounded-pill">
                                        <i class="bi bi-github me-1"></i> GitHub
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    @if (isOwnProfile)
                    {
                        <div class="mt-3 mt-md-0">
                            <a asp-action="Edit" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                <i class="bi bi-pencil me-1"></i> Edit Profile
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Posts by this Author -->
    <div class="col-12">
        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-journal-text text-primary"></i> Published Articles
            <span class="badge bg-secondary-subtle text-secondary fs-6 rounded-pill">@(Model?.Posts?.Count ?? 0)</span>
        </h4>

        @if (Model?.Posts != null && Model.Posts.Any())
        {
            <div class="row g-4">
                @foreach (var post in Model.Posts.OrderByDescending(p => p.CreatedAt))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 modern-card">
                            @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                            {
                                <div class="card-img-wrapper">
                                    <img src="@post.FeaturedImageUrl" alt="@post.Title" />
                                    @if (post.Category != null)
                                    {
                                        <span class="card-category-badge">@post.Category.Name</span>
                                    }
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                @if (string.IsNullOrEmpty(post.FeaturedImageUrl) && post.Category != null)
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">@post.Category.Name</span>
                                    </div>
                                }
                                <h5 class="card-title fw-bold">
                                    <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" class="text-dark text-decoration-none">
                                        @post.Title
                                    </a>
                                </h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    @Html.Raw(post.Content?.Length > 120 ? post.Content.Substring(0, 120) + "..." : post.Content)
                                </p>
                                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center text-muted small">
                                    <span>@post.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                    <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary rounded-pill">Read</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
                <i class="bi bi-pencil-square fs-1 mb-2 text-secondary"></i>
                <h5>No articles published yet</h5>
                <p class="small mb-0">Check back later for stories published by @(Model?.UserName ?? "this user").</p>
            </div>
        }
    </div>
</div>
