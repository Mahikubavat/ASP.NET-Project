@model BlogPlatform.ViewModels.ProfileEditViewModel
@{
    ViewData["Title"] = "Edit Profile & Settings";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h3 class="card-title h4 mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-person-gear text-primary"></i> Profile & Settings
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Profile Info Section -->
                    <h5 class="form-section-title">
                        <i class="bi bi-info-circle me-1 text-primary"></i> Public Profile
                    </h5>

                    <div class="row mb-4 align-items-center">
                        <div class="col-md-3 text-center mb-3 mb-md-0">
                            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                <img src="@Model.ProfilePictureUrl" class="rounded-circle shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="Profile Picture" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 100px; height: 100px; font-size: 2.5rem;">
                                    <i class="bi bi-person"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-9">
                            <label asp-for="ProfilePicture" class="form-label fw-medium">Change Profile Picture</label>
                            <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
                            <div class="text-muted smaller mt-1">Recommended: Square JPG, PNG, or WebP up to 5MB.</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Bio" class="form-label fw-medium">Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell readers about yourself, your background, and your interests..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    <!-- Social Links Section -->
                    <h5 class="form-section-title">
                        <i class="bi bi-link-45deg me-1 text-primary"></i> Social Profiles
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="TwitterUrl" class="form-label small fw-medium">
                                <i class="bi bi-twitter-x me-1"></i> Twitter / X
                            </label>
                            <input asp-for="TwitterUrl" class="form-control" placeholder="https://x.com/username" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LinkedInUrl" class="form-label small fw-medium">
                                <i class="bi bi-linkedin me-1 text-primary"></i> LinkedIn
                            </label>
                            <input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/username" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="GitHubUrl" class="form-label small fw-medium">
                                <i class="bi bi-github me-1"></i> GitHub
                            </label>
                            <input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/username" />
                        </div>
                    </div>

                    <!-- Notification Preferences Section -->
                    <h5 class="form-section-title">
                        <i class="bi bi-bell me-1 text-primary"></i> Notification Preferences
                    </h5>

                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="NotifyOnLike" id="notifyLikeSwitch" />
                            <label class="form-check-label fw-semibold" for="notifyLikeSwitch">
                                Like Notifications
                            </label>
                            <div class="text-muted small">
                                Receive notifications when other users like your articles.
                            </div>
                        </div>

                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" asp-for="NotifyOnComment" id="notifyCommentSwitch" />
                            <label class="form-check-label fw-semibold" for="notifyCommentSwitch">
                                Comment & Reply Notifications
                            </label>
                            <div class="text-muted small">
                                Receive notifications when someone comments on your post or replies to your comments.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary-modern px-4" type="submit">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                        <a asp-action="Public" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
