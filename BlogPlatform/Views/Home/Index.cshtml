@model IEnumerable<BlogPlatform.Models.Post>?

@{
    ViewData["Title"] = "Welcome to BlogPlatform - Read, Write & Connect";
    var categories = ViewBag.Categories as IEnumerable<BlogPlatform.Models.Category> ?? Enumerable.Empty<BlogPlatform.Models.Category>();
    var popularTags = ViewBag.PopularTags as IEnumerable<BlogPlatform.Models.Tag> ?? Enumerable.Empty<BlogPlatform.Models.Tag>();
}

<!-- Hero Section -->
<div class="hero-banner shadow-sm">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                <i class="bi bi-stars text-warning me-1"></i> Welcome to BlogPlatform
            </span>
            <h1 class="display-4 fw-bold mb-3" style="letter-spacing: -1px;">
                Where good ideas find their readers.
            </h1>
            <p class="lead text-light mb-4" style="opacity: 0.9; max-width: 600px;">
                Read, write, and deepen your understanding of software engineering, web development, lifestyle, design, and ideas that matter.
            </p>
            <div class="d-flex flex-wrap gap-2">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Writer") || User.IsInRole("Admin"))
                    {
                        <a class="btn btn-light fw-bold px-4 py-2 rounded-pill shadow-sm" asp-controller="Posts" asp-action="Create">
                            <i class="bi bi-pencil-square me-1 text-primary"></i> Write a Story
                        </a>
                    }
                    <a class="btn btn-outline-light px-4 py-2 rounded-pill" asp-controller="Posts" asp-action="Index">
                        Explore All Posts
                    </a>
                }
                else
                {
                    <a class="btn btn-light fw-bold px-4 py-2 rounded-pill shadow-sm" asp-area="Identity" asp-page="/Account/Register">
                        Start Reading & Writing
                    </a>
                    <a class="btn btn-outline-light px-4 py-2 rounded-pill" asp-controller="Posts" asp-action="Index">
                        Explore Stories
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Popular Topics / Categories & Tags Ribbon -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-5 bg-white">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold small text-muted text-uppercase" style="letter-spacing:0.5px;">Popular Topics:</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var cat in categories)
            {
                <a asp-controller="Posts" asp-action="Index" asp-route-categoryId="@cat.Id" class="badge bg-light text-dark text-decoration-none border py-2 px-3 rounded-pill fw-medium">
                    <i class="bi bi-folder2 text-primary me-1"></i> @cat.Name
                </a>
            }
            @foreach (var tag in popularTags.Take(5))
            {
                <a asp-controller="Posts" asp-action="Index" asp-route-tag="@tag.Name" class="tag-pill">
                    #@tag.Name
                </a>
            }
        </div>
    </div>
</div>

<!-- Latest Articles Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-fire text-danger"></i> Latest Articles
        </h2>
        <p class="text-muted small mb-0">Handpicked stories and tutorials from our community.</p>
    </div>
    <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="Posts" asp-action="Index">
        View All <i class="bi bi-arrow-right ms-1"></i>
    </a>
</div>

<!-- Articles Grid -->
@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <i class="bi bi-journal-text display-3 text-secondary d-block mb-3"></i>
        <h4 class="fw-bold">No articles yet</h4>
        <p class="text-muted mb-4">Be the first writer to publish an article on BlogPlatform!</p>
        <div>
            <a class="btn btn-primary-modern px-4" asp-controller="Posts" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i> Create First Post
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        @foreach (var post in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 modern-card shadow-sm d-flex flex-column">
                    @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                    {
                        <div class="card-img-wrapper">
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">
                                <img src="@post.FeaturedImageUrl" alt="@post.Title" />
                            </a>
                            @if (post.Category != null)
                            {
                                <a asp-controller="Posts" asp-action="Index" asp-route-categoryId="@post.CategoryId" class="card-category-badge">
                                    @post.Category.Name
                                </a>
                            }
                        </div>
                    }

                    <div class="card-body d-flex flex-column p-4">
                        @if (string.IsNullOrEmpty(post.FeaturedImageUrl) && post.Category != null)
                        {
                            <div class="mb-2">
                                <a asp-controller="Posts" asp-action="Index" asp-route-categoryId="@post.CategoryId" class="badge bg-primary-subtle text-primary rounded-pill text-decoration-none">
                                    @post.Category.Name
                                </a>
                            </div>
                        }

                        <h5 class="card-title fw-bold mb-2">
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" class="text-dark text-decoration-none">
                                @post.Title
                            </a>
                        </h5>

                        <p class="card-text text-muted small flex-grow-1 mb-3">
                            @{
                                var raw = post.Content ?? "";
                                var clean = System.Text.RegularExpressions.Regex.Replace(raw, "<.*?>", string.Empty);
                                var snippet = clean.Length > 110 ? clean.Substring(0, 110) + "..." : clean;
                            }
                            @snippet
                        </p>

                        <!-- Post Tags Visible on Post Card -->
                        @if (post.PostTags != null && post.PostTags.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var pt in post.PostTags.Take(3))
                                {
                                    if (pt.Tag != null)
                                    {
                                        <a asp-controller="Posts" asp-action="Index" asp-route-tag="@pt.Tag.Name" class="tag-pill" style="font-size:0.72rem; padding: 0.2rem 0.5rem;">
                                            #@pt.Tag.Name
                                        </a>
                                    }
                                }
                            </div>
                        }

                        <!-- Author & Engagement Stats -->
                        <div class="pt-3 border-top mt-auto d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials-sm" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                    @((post.Author?.UserName?.Length > 0 ? post.Author.UserName[0].ToString().ToUpper() : "A"))
                                </span>
                                <div class="text-muted smaller" style="font-size: 0.78rem;">
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 100px;">@(post.Author?.UserName ?? "Writer")</div>
                                    <div>@post.CreatedAt.ToLocalTime().ToString("MMM dd")</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <span title="Likes"><i class="bi bi-heart text-danger"></i> @(post.Likes?.Count ?? 0)</span>
                                <span title="Comments"><i class="bi bi-chat-text text-secondary"></i> @(post.Comments?.Count ?? 0)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Call to action card -->
@if (User?.Identity?.IsAuthenticated != true)
{
    <div class="card border-0 rounded-4 shadow-sm text-center p-5 mb-4" style="background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);">
        <div class="py-2">
            <h3 class="fw-bold mb-2">Ready to share your voice with the world?</h3>
            <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">Join the BlogPlatform community today. Write articles, receive feedback, and engage with fellow enthusiasts.</p>
            <a class="btn btn-primary-modern px-4 py-2" asp-area="Identity" asp-page="/Account/Register">Create Free Account</a>
        </div>
    </div>
}
