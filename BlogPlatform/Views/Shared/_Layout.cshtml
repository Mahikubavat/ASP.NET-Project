@using Microsoft.AspNetCore.Identity
@using BlogPlatform.Models
@using BlogPlatform.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService NotificationService

@{
    int unreadNotificationsCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(currentUserId))
        {
            unreadNotificationsCount = await NotificationService.GetUnreadCountAsync(currentUserId);
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlogPlatform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BlogPlatform.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand navbar-brand-modern" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-journal-richtext"></i></span>
                    <span>BlogPlatform</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link nav-link-modern" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-modern" asp-area="" asp-controller="Posts" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Explore Posts
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Writer") || User.IsInRole("Admin")))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-modern" asp-area="" asp-controller="Posts" asp-action="Manage">
                                    <i class="bi bi-kanban me-1"></i> My Posts
                                </a>
                            </li>
                        }
                    </ul>

                    @* Global search bar with categories *@
                    <div class="d-none d-lg-block me-3" style="min-width: 340px;">
                        @await Component.InvokeAsync("CategoryList")
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @* Write Post Shortcut *@
                            @if (User.IsInRole("Writer") || User.IsInRole("Admin"))
                            {
                                <a class="btn btn-light btn-sm fw-semibold rounded-pill px-3 shadow-sm me-1" asp-controller="Posts" asp-action="Create">
                                    <i class="bi bi-pencil-square me-1 text-primary"></i> Write
                                </a>
                            }

                            @* Notification Bell *@
                            <div class="dropdown me-1">
                                <a class="notification-bell-btn text-decoration-none" asp-controller="Notifications" asp-action="Index" id="notificationDropdown" role="button" title="Notifications">
                                    <i class="bi bi-bell-fill"></i>
                                    @if (unreadNotificationsCount > 0)
                                    {
                                        <span class="notification-badge" id="navbarNotificationBadge">@(unreadNotificationsCount > 9 ? "9+" : unreadNotificationsCount.ToString())</span>
                                    }
                                </a>
                            </div>

                            @* User Profile Dropdown *@
                            <div class="dropdown">
                                <button class="btn btn-link p-0 text-decoration-none dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar-initials-sm">@((User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U"))</span>
                                    <span class="text-white small fw-medium d-none d-md-inline">@User.Identity?.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" aria-labelledby="userMenuBtn">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold small text-truncate">@User.Identity?.Name</div>
                                        <div class="text-muted smaller" style="font-size:0.75rem;">
                                            @(User.IsInRole("Admin") ? "Administrator" : User.IsInRole("Writer") ? "Author / Writer" : "Reader")
                                        </div>
                                    </li>
                                    @{
                                        var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                    }
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Profile" asp-action="Public" asp-route-id="@currentUserId">
                                            <i class="bi bi-person me-2 text-primary"></i> Public Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Bookmarks" asp-action="Index">
                                            <i class="bi bi-bookmark-heart me-2 text-warning"></i> Saved Posts
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Profile" asp-action="Edit">
                                            <i class="bi bi-gear me-2 text-secondary"></i> Edit Profile & Settings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Notifications" asp-action="Index">
                                            <i class="bi bi-bell me-2 text-warning"></i> Notifications
                                            @if (unreadNotificationsCount > 0)
                                            {
                                                <span class="badge bg-danger ms-auto float-end">@unreadNotificationsCount</span>
                                            }
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Writer") || User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Posts" asp-action="Manage">
                                                <i class="bi bi-kanban me-2 text-success"></i> Manage Posts
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Posts" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-info"></i> Create New Post
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Log out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
                            <a class="btn btn-light btn-sm rounded-pill px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        @* Flash Alert Messages *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-modern mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <span class="brand-icon" style="width:24px; height:24px; font-size:0.85rem;"><i class="bi bi-journal-richtext"></i></span>
                        <strong class="text-dark">BlogPlatform</strong>
                    </div>
                    <p class="text-muted small mb-0">Share your stories, ideas, and connect with writers worldwide.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3 mb-1">
                        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small">Home</a>
                        <a asp-controller="Posts" asp-action="Index" class="text-muted text-decoration-none small">Articles</a>
                        <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none small">Privacy Policy</a>
                    </div>
                    <div class="text-muted small">&copy; @DateTime.UtcNow.Year BlogPlatform Inc. All rights reserved.</div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
