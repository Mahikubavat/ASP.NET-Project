<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlogPlatform</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BlogPlatform.styles.css" asp-append-version="true" />
    <style>
        /* Small, self-contained layout tweaks to modernize default scaffold */
        .navbar-brand { font-weight: 700; letter-spacing: .3px; }
        .nav-action-btn { margin-left: .5rem; }
        .card-meta { font-size: .9rem; }
        .empty-state { padding: 4rem 2rem; border: 1px dashed #dee2e6; border-radius: .5rem; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BlogPlatform</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Posts" asp-action="Index">Manage Posts</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Writer") || User.IsInRole("Admin")))
                        {
                            <a class="btn btn-outline-light me-2 d-none d-lg-inline" asp-controller="Posts" asp-action="Index">
                                <i class="bi bi-layout-text-sidebar-reverse"></i> Dashboard
                            </a>
                            <a class="btn btn-light me-2" asp-controller="Posts" asp-action="Create">
                                <i class="bi bi-plus-lg"></i> New Post
                            </a>
                        }
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container d-flex justify-content-between">
            <div>&copy; @DateTime.UtcNow.Year - BlogPlatform</div>
            <div><a class="text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
