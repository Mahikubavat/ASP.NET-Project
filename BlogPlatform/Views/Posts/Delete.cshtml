@model BlogPlatform.Models.Post

@{
    ViewData["Title"] = "Delete Post";
}

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <h2 class="card-title text-danger">Delete Post</h2>
        <p class="text-muted">Are you sure you want to permanently delete the following post?</p>

        <div class="mb-3">
            <h4>@Model.Title</h4>
            <p class="text-muted">@Model.CreatedAt.ToLocalTime().ToString("f") @if (Model.Author != null) { <span>• @Model.Author.UserName</span> }</p>
            <div class="border rounded p-3 mb-3">@Html.Raw(Model.Content)</div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
