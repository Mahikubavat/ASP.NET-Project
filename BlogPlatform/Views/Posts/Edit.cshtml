@model BlogPlatform.ViewModels.PostCreateEditViewModel

@{
    ViewData["Title"] = "Edit Post - " + (Model?.Title ?? "");
    var defaultTags = ViewBag.Tags as IEnumerable<BlogPlatform.Models.Tag> ?? Enumerable.Empty<BlogPlatform.Models.Tag>();
    var selectedIds = Model?.SelectedTagIds ?? new List<int>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-pencil text-primary"></i> Edit Post
        </h1>
        <p class="text-muted small mb-0">Update your article content, tags, or publication settings.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-eye me-1"></i> View Post
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Posts
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="editPostForm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingFeaturedImageUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

    <div class="row g-4">
        <!-- Main Content Area -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-bold">Post Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter an engaging title..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Slug" class="form-label fw-medium text-muted small">URL Slug</label>
                        <input asp-for="Slug" class="form-control form-control-sm" placeholder="custom-url-slug" />
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-bold">Content <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control font-monospace" rows="14" placeholder="Write your post content here... HTML is supported for rich formatting."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Tags Section -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-tags-fill text-primary"></i> Tags
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-flex justify-content-between align-items-center mb-2">
                            <span>Popular Tags</span>
                            <span class="text-muted smaller" style="font-size:0.8rem;">Top 10 popular tags; selected tags remain visible</span>
                        </label>
                        <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border" id="tagsContainer">
                            @if (defaultTags.Any())
                            {
                                foreach (var tag in defaultTags)
                                {
                                    bool isSel = selectedIds.Contains(tag.Id);
                                    <span class="tag-pill tag-interactive-chip @(isSel ? "selected" : "")"
                                          data-tag-id="@tag.Id"
                                          onclick="toggleTagChip(this, @tag.Id)">
                                        <i class="bi @(isSel ? "bi-check-circle-fill text-white" : "bi-plus-circle text-muted") me-1"></i>
                                        @tag.Name
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">No popular tags yet. You can add custom tags below.</span>
                            }
                        </div>
                        <div id="tagSuggestionsError" class="text-danger small mt-2 d-none" role="alert">
                            Tags could not be refreshed. Please try changing the category again.
                        </div>

                        <!-- Hidden multi-select bound to SelectedTagIds -->
                        <select asp-for="SelectedTagIds" id="hiddenSelectedTagIds" multiple class="d-none">
                            @foreach (var tag in defaultTags)
                            {
                                if (selectedIds.Contains(tag.Id))
                                {
                                    <option value="@tag.Id" selected="selected">@tag.Name</option>
                                }
                                else
                                {
                                    <option value="@tag.Id">@tag.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-0">
                        <label asp-for="TagsCommaSeparated" class="form-label fw-semibold">
                            Additional Custom Tags (comma separated)
                        </label>
                        <input asp-for="TagsCommaSeparated" class="form-control" placeholder="e.g. dotnet, clean-code, aspnetcore" />
                        <div class="form-text small">Add any tags not shown above, separated by commas.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar / Publishing Settings -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 mb-4 sticky-top" style="top: 80px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-sliders2 text-primary"></i> Publishing Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <!-- Category Dropdown -->
                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label fw-bold">
                            <i class="bi bi-folder2-open text-primary me-1"></i> Category
                        </label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Status Selector -->
                    <div class="mb-4">
                        <label asp-for="IsPublished" class="form-label fw-bold">
                            <i class="bi bi-send text-primary me-1"></i> Publication Status
                        </label>
                        <select asp-for="IsPublished" class="form-select">
                            <option value="true">Published</option>
                            <option value="false">Draft</option>
                        </select>
                        <span asp-validation-for="IsPublished" class="text-danger small"></span>
                    </div>

                    <!-- Featured Image -->
                    <div class="mb-4">
                        <label asp-for="FeaturedImage" class="form-label fw-bold">
                            <i class="bi bi-image text-primary me-1"></i> Cover Image
                        </label>
                        @if (!string.IsNullOrEmpty(Model.ExistingFeaturedImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingFeaturedImageUrl" class="img-fluid rounded border shadow-sm" style="max-height: 140px; width: 100%; object-fit: cover;" alt="Current Cover" />
                                <div class="text-muted smaller mt-1">Current cover image</div>
                            </div>
                        }
                        <input asp-for="FeaturedImage" type="file" class="form-control" id="featuredImageInput" accept="image/*" />
                        <span asp-validation-for="FeaturedImage" class="text-danger small"></span>
                        <div id="imagePreviewContainer" class="mt-2 d-none">
                            <img id="imagePreview" src="#" alt="New Preview" class="img-fluid rounded border shadow-sm" style="max-height: 140px; width: 100%; object-fit: cover;" />
                            <div class="text-success smaller mt-1">New image selected</div>
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary-modern py-2">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const selectedTagIdsElement = document.getElementById('hiddenSelectedTagIds');
        const tagsContainer = document.getElementById('tagsContainer');
        const tagSuggestionsUrl = '@Url.Action("TagSuggestions", "Posts")';
        let tagRequestNumber = 0;

        function toggleTagChip(chip, tagId) {
            chip.classList.toggle('selected');
            var isSel = chip.classList.contains('selected');
            var icon = chip.querySelector('i');
            if (isSel) {
                icon.className = 'bi bi-check-circle-fill text-white me-1';
            } else {
                icon.className = 'bi bi-plus-circle text-muted me-1';
            }

            for (var i = 0; i < selectedTagIdsElement.options.length; i++) {
                if (selectedTagIdsElement.options[i].value == tagId) {
                    selectedTagIdsElement.options[i].selected = isSel;
                    break;
                }
            }
        }

        document.getElementById('CategoryId').addEventListener('change', async function () {
            const requestNumber = ++tagRequestNumber;
            const query = new URLSearchParams();
            if (this.value) query.set('categoryId', this.value);
            for (const option of selectedTagIdsElement.selectedOptions) {
                query.append('selectedTagIds', option.value);
            }

            try {
                const response = await fetch(tagSuggestionsUrl + '?' + query.toString());
                if (!response.ok) throw new Error('Tag suggestions request failed.');
                const tags = await response.json();
                if (requestNumber !== tagRequestNumber) return;

                const selectedOptions = Array.from(selectedTagIdsElement.selectedOptions);
                const selectedIds = new Set(selectedOptions.map(option => option.value));
                const tagsById = new Map(tags.map(tag => [String(tag.id), tag]));
                for (const option of selectedOptions) {
                    if (!tagsById.has(option.value)) {
                        tags.push({ id: option.value, name: option.textContent });
                    }
                }

                tagsContainer.replaceChildren();
                selectedTagIdsElement.replaceChildren();

                for (const tag of tags) {
                    const isSelected = selectedIds.has(String(tag.id));
                    const chip = document.createElement('span');
                    chip.className = 'tag-pill tag-interactive-chip' + (isSelected ? ' selected' : '');
                    chip.dataset.tagId = tag.id;
                    chip.addEventListener('click', () => toggleTagChip(chip, tag.id));

                    const icon = document.createElement('i');
                    icon.className = isSelected
                        ? 'bi bi-check-circle-fill text-white me-1'
                        : 'bi bi-plus-circle text-muted me-1';
                    chip.append(icon, document.createTextNode(tag.name));
                    tagsContainer.appendChild(chip);

                    const option = document.createElement('option');
                    option.value = tag.id;
                    option.textContent = tag.name;
                    option.selected = isSelected;
                    selectedTagIdsElement.appendChild(option);
                }

                if (tags.length === 0) {
                    tagsContainer.textContent = 'No tags available yet. Add custom tags below.';
                }
                document.getElementById('tagSuggestionsError').classList.add('d-none');
            } catch (error) {
                if (requestNumber !== tagRequestNumber) return;
                document.getElementById('tagSuggestionsError').classList.remove('d-none');
                console.error(error);
            }
        });

        // Image Preview
        document.getElementById('featuredImageInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(evt) {
                    document.getElementById('imagePreview').src = evt.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                document.getElementById('imagePreviewContainer').classList.add('d-none');
            }
        });
    </script>
}
