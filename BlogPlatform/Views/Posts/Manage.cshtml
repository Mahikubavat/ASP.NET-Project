@model IEnumerable<BlogPlatform.Models.Post>

@{
    ViewData["Title"] = "Manage My Posts";
    string currentStatus = ViewBag.CurrentStatus as string ?? "all";
    string? currentSearch = ViewBag.CurrentSearch as string;
    int totalCount = ViewBag.TotalCount ?? 0;
    int publishedCount = ViewBag.PublishedCount ?? 0;
    int draftCount = ViewBag.DraftCount ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-kanban text-primary"></i> Manage Your Posts
        </h1>
        <p class="text-muted small mb-0">Overview of your published stories and in-progress drafts.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-modern shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Create New Post
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-action="Manage" asp-route-status="all" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 p-3 @(currentStatus == "all" ? "border-start border-primary border-4 bg-white" : "bg-white")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Posts</div>
                        <div class="h3 fw-bold text-dark mb-0">@totalCount</div>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                        <i class="bi bi-journal-text fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Manage" asp-route-status="published" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 p-3 @(currentStatus == "published" ? "border-start border-success border-4 bg-white" : "bg-white")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Published</div>
                        <div class="h3 fw-bold text-success mb-0">@publishedCount</div>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Manage" asp-route-status="draft" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 p-3 @(currentStatus == "draft" ? "border-start border-warning border-4 bg-white" : "bg-white")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Drafts</div>
                        <div class="h3 fw-bold text-warning mb-0">@draftCount</div>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Filter Tabs & Search -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <ul class="nav nav-pills gap-1">
                <li class="nav-item">
                    <a asp-action="Manage" asp-route-status="all" asp-route-q="@currentSearch" class="nav-link @(currentStatus == "all" ? "active" : "text-muted") py-1 px-3 small fw-semibold">
                        All (@totalCount)
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Manage" asp-route-status="published" asp-route-q="@currentSearch" class="nav-link @(currentStatus == "published" ? "active" : "text-muted") py-1 px-3 small fw-semibold">
                        Published (@publishedCount)
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Manage" asp-route-status="draft" asp-route-q="@currentSearch" class="nav-link @(currentStatus == "draft" ? "active" : "text-muted") py-1 px-3 small fw-semibold">
                        Drafts (@draftCount)
                    </a>
                </li>
            </ul>

            <form method="get" asp-action="Manage" class="d-flex" style="max-width: 300px;">
                <input type="hidden" name="status" value="@currentStatus" />
                <div class="input-group input-group-sm">
                    <input name="q" value="@currentSearch" class="form-control" placeholder="Search my stories..." />
                    <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <a asp-action="Manage" asp-route-status="@currentStatus" class="btn btn-outline-secondary" title="Clear search">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Posts List / Management Table -->
@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4 bg-white">
        <i class="bi bi-file-earmark-plus display-3 text-secondary d-block mb-3"></i>
        <h4 class="fw-bold mb-2">No @(currentStatus != "all" ? currentStatus : "") posts found</h4>
        <p class="text-muted mb-4">
            @(currentStatus == "draft" ? "You don't have any saved drafts." : "You haven't written any posts matching this filter.")
        </p>
        <div>
            <a asp-action="Create" class="btn btn-primary-modern px-4">
                <i class="bi bi-pencil-square me-1"></i> Write a New Post
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3" style="min-width: 280px;">Title & Content</th>
                        <th class="py-3">Category</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Date</th>
                        <th class="text-end pe-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var post in Model)
                    {
                        var postUrl = string.IsNullOrWhiteSpace(post.Slug)
                            ? Url.RouteUrl("PostDetailsById", new { id = post.Id })
                            : Url.RouteUrl("PostDetailsBySlug", new { slug = post.Slug });

                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                                    {
                                        <img src="@post.FeaturedImageUrl" class="rounded shadow-sm" style="width: 52px; height: 52px; object-fit: cover;" alt="@post.Title" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light text-secondary d-flex align-items-center justify-content-center border" style="width: 52px; height: 52px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                    <div>
                                        <a href="@postUrl" class="text-dark fw-bold text-decoration-none d-block text-truncate" style="max-width: 320px;">
                                            @post.Title
                                        </a>
                                        <div class="text-muted smaller mt-1 d-flex flex-wrap gap-1">
                                            @if (post.PostTags != null && post.PostTags.Any())
                                            {
                                                foreach (var pt in post.PostTags.Take(2))
                                                {
                                                    if (pt.Tag != null)
                                                    {
                                                        <span class="badge bg-light text-secondary border py-1 px-1.5" style="font-size:0.7rem;">#@pt.Tag.Name</span>
                                                    }
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (post.Category != null)
                                {
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1">
                                        @post.Category.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td>
                                @if (post.Status == BlogPlatform.Models.PostStatus.Published)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2.5 py-1.5 rounded-pill fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i> Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-dark border border-warning border-opacity-25 px-2.5 py-1.5 rounded-pill fw-semibold">
                                        <i class="bi bi-clock-history me-1"></i> Draft
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="text-dark small">@post.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                @if (post.UpdatedAt.HasValue)
                                {
                                    <div class="text-muted smaller" style="font-size: 0.75rem;">Edited @post.UpdatedAt.Value.ToLocalTime().ToString("MMM dd")</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-outline-primary" title="Edit article">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <a href="@postUrl" class="btn btn-outline-secondary" title="View or preview">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-outline-danger" title="Delete article">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
