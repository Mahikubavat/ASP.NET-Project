@model BlogPlatform.Models.Post

@{
    ViewData["Title"] = Model?.Title ?? "Post Details";
}

<article class="card shadow-sm">
    @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
    {
        <img src="@Model.FeaturedImageUrl" class="card-img-top" style="object-fit:cover; height:320px;" alt="@Model.Title" />
    }
    <div class="card-body">
        <h1 class="card-title">@Model.Title</h1>
        <div class="mb-3 text-muted">
            <small>@Model.CreatedAt.ToLocalTime().ToString("f")</small>
            @if (Model.Author != null) { <span class="ms-2">• @Model.Author.UserName</span> }
            @if (Model.Category != null) { <span class="badge bg-secondary ms-3">@Model.Category.Name</span> }
        </div>

        <div class="card-text">@Html.Raw(Model.Content)</div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <div>
            <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
        <div>
            @{
                var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var canManage = User.Identity?.IsAuthenticated == true &&
                    (User.IsInRole("Admin") || (User.IsInRole("Writer") && Model.AuthorId == currentUserId));
            }
            @if (canManage)
            {
                <a class="btn btn-success me-2" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="bi bi-trash"></i> Delete</a>
            }
        </div>
    </div>
</article>
