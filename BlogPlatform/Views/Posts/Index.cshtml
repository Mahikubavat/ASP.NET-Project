@model IEnumerable<BlogPlatform.Models.Post>?

@{
    ViewData["Title"] = "Manage Posts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Posts</h1>
    <div>
        <a class="btn btn-outline-secondary me-2" asp-action="Index"><i class="bi bi-arrow-repeat"></i> Refresh</a>
        @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Writer") || User.IsInRole("Admin")))
        {
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New Post</a>
        }
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-state text-center">
        <h4 class="mb-2">No posts yet</h4>
        <p class="text-muted mb-3">Create your first post to get started.</p>
        <a class="btn btn-lg btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Create Post</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                    {
                        <img src="@post.FeaturedImageUrl" class="card-img-top" style="object-fit:cover; height:180px;" alt="@post.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@post.Title</h5>
                        <p class="card-text text-truncate">@Html.Raw(post.Content?.Length > 180 ? post.Content.Substring(0, 180) + "..." : post.Content)</p>
                        <div class="mt-2">
                            @if (post.Category != null)
                            {
                                <span class="badge bg-secondary me-1">@post.Category.Name</span>
                            }
                            <span class="badge @(post.Status == BlogPlatform.Models.PostStatus.Published ? "bg-success" : "bg-warning text-dark")">@post.Status</span>
                        </div>
                        <div class="mt-auto pt-3 d-flex justify-content-between align-items-center">
                            <div class="card-meta text-muted">@post.CreatedAt.ToLocalTime().ToString("g") @if (post.Author != null) { <span>• @post.Author.UserName</span> }</div>
                            <div>
                                <a class="btn btn-sm btn-outline-primary me-1" asp-action="Details" asp-route-id="@post.Id"><i class="bi bi-eye"></i></a>
                                @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Writer") || User.IsInRole("Admin")))
                                {
                                    <a class="btn btn-sm btn-outline-success me-1" asp-action="Edit" asp-route-id="@post.Id"><i class="bi bi-pencil"></i></a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@post.Id"><i class="bi bi-trash"></i></a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
