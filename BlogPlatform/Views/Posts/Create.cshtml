@model BlogPlatform.ViewModels.PostCreateEditViewModel

@{
    ViewData["Title"] = "Create Post";
    var defaultTags = ViewBag.Tags as IEnumerable<BlogPlatform.Models.Tag> ?? Enumerable.Empty<BlogPlatform.Models.Tag>();
    var selectedIds = Model?.SelectedTagIds ?? new List<int>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-pencil-square text-primary"></i> Create New Post
        </h1>
        <p class="text-muted small mb-0">Write and publish your thoughts, tutorials, or insights.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Posts
    </a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="createPostForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

    <div class="row g-4">
        <!-- Main Content Area -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-bold">Post Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter an engaging title..." autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Slug" class="form-label fw-medium text-muted small">URL Slug (Optional)</label>
                        <input asp-for="Slug" class="form-control form-control-sm" placeholder="custom-url-slug (auto-generated from title if blank)" />
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-bold">Content <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control font-monospace" rows="14" placeholder="Write your post content here... HTML is supported for rich formatting."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Tags Section -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-tags-fill text-primary"></i> Tags
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-flex justify-content-between align-items-center mb-2">
                            <span>Default Topics & Tags</span>
                            <span class="text-muted smaller" style="font-size:0.8rem;">Click to select or deselect</span>
                        </label>
                        <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border" id="tagsContainer">
                            @if (defaultTags.Any())
                            {
                                foreach (var tag in defaultTags)
                                {
                                    bool isSel = selectedIds.Contains(tag.Id);
                                    <span class="tag-pill tag-interactive-chip @(isSel ? "selected" : "")"
                                          data-tag-id="@tag.Id"
                                          onclick="toggleTagChip(this, @tag.Id)">
                                        <i class="bi @(isSel ? "bi-check-circle-fill text-white" : "bi-plus-circle text-muted") me-1"></i>
                                        @tag.Name
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">No tags defined yet. You can add custom tags below!</span>
                            }
                        </div>

                        <!-- Hidden multi-select bound to SelectedTagIds -->
                        <select asp-for="SelectedTagIds" id="hiddenSelectedTagIds" multiple class="d-none">
                            @foreach (var tag in defaultTags)
                            {
                                if (selectedIds.Contains(tag.Id))
                                {
                                    <option value="@tag.Id" selected="selected">@tag.Name</option>
                                }
                                else
                                {
                                    <option value="@tag.Id">@tag.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-0">
                        <label asp-for="TagsCommaSeparated" class="form-label fw-semibold">
                            Custom Tags (comma separated)
                        </label>
                        <input asp-for="TagsCommaSeparated" class="form-control" placeholder="e.g. dotnet, clean-code, aspnetcore" />
                        <div class="form-text small">Add any custom tags not in the default list above, separated by commas.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar / Publishing Settings -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 mb-4 sticky-top" style="top: 80px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-sliders2 text-primary"></i> Publishing Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <!-- Category Dropdown -->
                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label fw-bold">
                            <i class="bi bi-folder2-open text-primary me-1"></i> Category
                        </label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        <div class="form-text small">Select the category that best fits your article.</div>
                    </div>

                    <!-- Status Selector -->
                    <div class="mb-4">
                        <label asp-for="IsPublished" class="form-label fw-bold">
                            <i class="bi bi-send text-primary me-1"></i> Publication Status
                        </label>
                        <select asp-for="IsPublished" class="form-select">
                            <option value="true">Publish Immediately</option>
                            <option value="false">Save as Draft</option>
                        </select>
                        <span asp-validation-for="IsPublished" class="text-danger small"></span>
                    </div>

                    <!-- Featured Image -->
                    <div class="mb-4">
                        <label asp-for="FeaturedImage" class="form-label fw-bold">
                            <i class="bi bi-image text-primary me-1"></i> Cover Image
                        </label>
                        <input asp-for="FeaturedImage" type="file" class="form-control" id="featuredImageInput" accept="image/*" />
                        <span asp-validation-for="FeaturedImage" class="text-danger small"></span>
                        <div id="imagePreviewContainer" class="mt-2 d-none">
                            <img id="imagePreview" src="#" alt="Cover Preview" class="img-fluid rounded border shadow-sm" style="max-height: 160px; width: 100%; object-fit: cover;" />
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary-modern py-2">
                            <i class="bi bi-check-lg me-1"></i> Publish Post
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleTagChip(chip, tagId) {
            chip.classList.toggle('selected');
            var isSel = chip.classList.contains('selected');
            var icon = chip.querySelector('i');
            if (isSel) {
                icon.className = 'bi bi-check-circle-fill text-white me-1';
            } else {
                icon.className = 'bi bi-plus-circle text-muted me-1';
            }

            var select = document.getElementById('hiddenSelectedTagIds');
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value == tagId) {
                    select.options[i].selected = isSel;
                    break;
                }
            }
        }

        // Image Preview
        document.getElementById('featuredImageInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(evt) {
                    document.getElementById('imagePreview').src = evt.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                document.getElementById('imagePreviewContainer').classList.add('d-none');
            }
        });
    </script>
}
